# Copy to .env and adjust. Everything defaults to a local, cloud-free setup.

# Which owner's jobs this worker processes (partition key).
ERRAND_OWNER=default

# Job store: local (files) | dynamodb
ERRAND_STORE=local
# Result sink: local (dir) | s3
ERRAND_SINK=local

# Claude Code CLI
ERRAND_CLAUDE_BIN=claude
ERRAND_DEFAULT_MODEL=sonnet
# ERRAND_CLAUDE_CWD=/path/to/a/codebase   # default codebase Claude may read
# Directories a job's own "cwd" must be inside (separated by ":" ; ";" on Windows).
# Defaults to ERRAND_CLAUDE_CWD only. If neither is set, jobs can't choose a cwd.
# ERRAND_ALLOWED_ROOTS=/path/to/repos:/path/to/other/repos

# Polling
ERRAND_POLL_INTERVAL=5

# Reclaiming jobs left "running" by a worker that died (crash, sleep, kill).
# ERRAND_STALE_AFTER=1200     # seconds; must be longer than ERRAND_CLAUDE_TIMEOUT
# ERRAND_MAX_ATTEMPTS=3

# --- AWS adapters (only if ERRAND_STORE=dynamodb or ERRAND_SINK=s3) ---
# ERRAND_JOBS_TABLE=errand-jobs
# ERRAND_S3_BUCKET=your-bucket
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile
