# Copy to .env and adjust. Everything defaults to a local, cloud-free setup.

# Which owner's jobs this worker processes (partition key).
ERRAND_OWNER=default

# Job store: local (files) | dynamodb
ERRAND_STORE=local
# Result sink: local (dir) | s3
ERRAND_SINK=local

# Claude Code CLI
ERRAND_CLAUDE_BIN=claude
ERRAND_DEFAULT_MODEL=sonnet
# ERRAND_CLAUDE_CWD=/path/to/a/codebase   # default codebase Claude may read

# Polling
ERRAND_POLL_INTERVAL=5

# --- AWS adapters (only if ERRAND_STORE=dynamodb or ERRAND_SINK=s3) ---
# ERRAND_JOBS_TABLE=errand-jobs
# ERRAND_S3_BUCKET=your-bucket
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile
